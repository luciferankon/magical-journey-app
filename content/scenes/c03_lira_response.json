        { "type": "trait_delta", "key": "courage", "value": 1 },
        { "type": "relationship_delta", "key": "lira_influence", "value": -1 }
      ],
      "next": "s14_solis_identified"
    },
    {
      "id": "c03_choice_d",
      "text": "\"I already know about the Fracture incidents. And the archive.\"",
      "gate": {
        "type": "flag_unset",
        "key": "crisis_fled"
      },
      "consequences": [
        { "type": "trait_delta", "key": "cunning", "value": 2 },
