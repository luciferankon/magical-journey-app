      ],
      "next": "s14_solis_identified"
    },
    {
      "id": "c03_choice_b",
      "text": "\"Why are you telling me this?\"",
      "consequences": [
        { "type": "trait_delta", "key": "wisdom", "value": 1 }
      ],
      "next": "s14_solis_identified"
    },
    {
      "id": "c03_choice_c",
      "text": "\"I'm not interested in whatever this is.\"",
